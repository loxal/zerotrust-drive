#
# Images for `just deb`. Ubuntu 22.04 (glibc 2.35) is the same baseline as the
# release CI job, so the packages also install on Debian 12 and on Ubuntu
# 22.04 through 26.04. fuser mounts through its pure-Rust path and
# fusermount3, so no libfuse3-dev or pkg-config is needed to build.
#
# packager: the tools packaging/deb/build-deb.sh and build-tarball.sh need. It
# runs on the package's own architecture, because dpkg-shlibdeps resolves
# shared-library dependencies against the native dpkg database; building it
# for a foreign architecture under emulation only runs apt.
FROM docker.io/library/ubuntu:22.04 AS packager

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        binutils dpkg-dev gzip \
    && rm -rf /var/lib/apt/lists/*

# builder: the Rust toolchain plus the cross linker for the other
# architecture, so both targets compile natively; rustc itself does not run
# reliably under qemu user emulation.
FROM packager AS builder

RUN case "$(dpkg --print-architecture)" in \
        amd64) cross="gcc-aarch64-linux-gnu libc6-dev-arm64-cross" ;; \
        arm64) cross="gcc-x86-64-linux-gnu libc6-dev-amd64-cross" ;; \
        *) echo "unsupported builder architecture" >&2; exit 1 ;; \
    esac \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl gcc libc6-dev $cross \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    AR_x86_64_unknown_linux_gnu=x86_64-linux-gnu-ar \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable \
    && rustup target add x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu \
    && rustc --version
